<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>Stairs</RootNamespace>
    <AssemblyName>StairsPlugin</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>10</LangVersion>
    <Version>1.1.5</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.35.*" />
    <PackageReference Include="Eto.Forms" Version="2.11.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- macOS AppleDouble files (._name) appear when a folder is copied to another file system -->
    <Compile Remove="**\._*" />
    <EmbeddedResource Remove="**\._*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\icons\*.png" Exclude="assets\icons\._*" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets\icons\StairsPlugin.ico" LogicalName="StairsPlugin.ico" />
  </ItemGroup>
</Project>
